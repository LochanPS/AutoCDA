# AutoCDA environment — copy to .env (gitignored) and fill in. NEVER commit real keys.

# ── LLM parser / proposer (optional; app works fully without any key) ──
# OpenRouter gives ONE OpenAI-compatible API over many providers' models (Claude,
# Llama, Gemini, DeepSeek, ...). "OpenAI-compatible" = the request format, not the
# catalog. Get a key at openrouter.ai.
OPENROUTER_API_KEY=
# Model slug. A $0 key can only call FREE models (":free"), which OpenRouter
# rotates and rate-limits HARD (429) — fine as a casual fallback (it degrades to
# regex on error) but not for real throughput. A few $ of credit unlocks paid
# models with normal limits. Browse current free slugs:
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Or Anthropic native instead of OpenRouter (needs a funded Anthropic key):
# REACT_APP_ANTHROPIC_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Verify API server (server/apiServer.mjs) ──
# Enable self-serve keys (POST /api/keys): any long random string.
KEY_SIGNING_SECRET=
# Keep a free host warm (ms < idle window) by self-pinging the public health URL.
KEEP_WARM_MS=600000
KEEP_WARM_URL=https://autocda-verify-api.onrender.com/api/health
# SPICE result cache: set to "off" to disable; SPICE_CACHE_MAX bounds entries.
# AUTOCDA_SPICE_CACHE=off
# SPICE_CACHE_MAX=1000
