# Copy to .env (which is gitignored) and fill in. NEVER commit real keys.

# --- Server-side only (read by server/pricingProxy.js). NOT bundled into the app. ---
# Your Mouser Search API key (mouser.com/api-hub). Lives only in the proxy process.
MOUSER_API_KEY=
# Optional: port for the pricing proxy (default 3001) and CORS origin lock-down.
# PRICING_PROXY_PORT=3001
# PRICING_CORS_ORIGIN=http://localhost:3000

# --- Client-side (REACT_APP_* ARE bundled — put ONLY non-secret values here) ---
# URL of the pricing proxy above. A URL is not a secret; the key stays server-side.
REACT_APP_PRICING_PROXY=http://localhost:3001/api/pricing
# Optional: Anthropic key for the LLM parser / in-loop proposer (demo/local only).
# REACT_APP_ANTHROPIC_KEY=
