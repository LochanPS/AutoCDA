# Copy to .env (which is gitignored) and fill in. NEVER commit real keys.

# --- Server-side only (read by server/pricingProxy.js). NOT bundled into the app. ---
# The BOM marketplace queries every distributor you give credentials for and picks
# the cheapest per part. Set one or both:
MOUSER_API_KEY=
# Digi-Key OAuth2 client credentials (developer.digikey.com):
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=
# Optional: port for the pricing proxy (default 3001) and CORS origin lock-down.
# PRICING_PROXY_PORT=3001
# PRICING_CORS_ORIGIN=http://localhost:3000

# --- Affiliate tagging (server-side, read by server/pricingProxy.js). NEVER bundled. ---
# Earn referral commission on BOM "Buy" clicks. Per distributor set ONE of:
#   AFFILIATE_<SRC>           query string appended to product links,
#                             e.g. AFFILIATE_MOUSER="utm_source=aff&aff_id=12345"
#   AFFILIATE_<SRC>_TEMPLATE  deep-link wrapper with a {url} placeholder,
#                             e.g. AFFILIATE_LCSC_TEMPLATE="https://click.net/deep?u={url}"
# <SRC> ∈ MOUSER, DIGIKEY, LCSC. See docs/AFFILIATE.md to register. Leave blank = plain links.
# AFFILIATE_MOUSER=
# AFFILIATE_DIGIKEY=
# AFFILIATE_LCSC=

# --- Client-side (REACT_APP_* ARE bundled — put ONLY non-secret values here) ---
# URL of the pricing proxy above. A URL is not a secret; the key stays server-side.
REACT_APP_PRICING_PROXY=http://localhost:3001/api/pricing
# Optional: Anthropic key for the LLM parser / in-loop proposer (demo/local only).
# REACT_APP_ANTHROPIC_KEY=

# (BOM "Buy" links are NEUTRAL multi-seller — no single default distributor and no
#  client-side affiliate tagging. Per-seller referral tagging, where a program exists,
#  is applied server-side in the pricing proxy via AFFILIATE_<SRC> above.)

# Waitlist: where the landing-page email form POSTs { email, source } as JSON.
# Use a free form backend (Formspree/Tally/Basin) or your own endpoint. If unset,
# the form falls back to a mailto to REACT_APP_WAITLIST_EMAIL.
# REACT_APP_WAITLIST_ENDPOINT=https://formspree.io/f/xxxxxxx
# REACT_APP_WAITLIST_EMAIL=you@example.com
