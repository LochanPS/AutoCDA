# AutoCDA environment — copy to .env (gitignored) and fill in. NEVER commit real keys.

# ── LLM parser / proposer (optional; app works fully without any key) ──
# OpenRouter (OpenAI-compatible, preferred when set). Get a key at openrouter.ai.
OPENROUTER_API_KEY=
# Any OpenRouter model slug; default anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Or Anthropic native instead of OpenRouter:
# REACT_APP_ANTHROPIC_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Verify API server (server/apiServer.mjs) ──
# Enable self-serve keys (POST /api/keys): any long random string.
KEY_SIGNING_SECRET=
# Keep a free host warm (ms < idle window) by self-pinging the public health URL.
KEEP_WARM_MS=600000
KEEP_WARM_URL=https://autocda-verify-api.onrender.com/api/health
# SPICE result cache: set to "off" to disable; SPICE_CACHE_MAX bounds entries.
# AUTOCDA_SPICE_CACHE=off
# SPICE_CACHE_MAX=1000
